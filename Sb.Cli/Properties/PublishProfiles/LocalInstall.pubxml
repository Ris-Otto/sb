<Project>
    <!--
      Publishes sb-cli as a single, self-contained sb-cli.exe directly into the same folder the app
      itself uses for its SQLite index (%APPDATA%\sb-cli\ — see Program.cs), and makes sure that folder is
      on the user's PATH so `sb-cli` can be run from any shell. Run via:
        dotnet publish Sb.Cli\Sb.Cli.csproj -p:PublishProfile=LocalInstall
      Re-running it simply overwrites sb-cli.exe in place with the newly built version.
      (template-main.tex is an embedded resource of Sb.Core, so no companion file needs copying.)
    -->
    <PropertyGroup>
        <Configuration>Release</Configuration>
        <Platform>Any CPU</Platform>
        <TargetFramework>net10.0</TargetFramework>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <PublishSingleFile>true</PublishSingleFile>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <PublishReadyToRun>false</PublishReadyToRun>
        <PublishTrimmed>false</PublishTrimmed>
        <PublishDir>$(APPDATA)\sb-cli\</PublishDir>
        <PublishProtocol>FileSystem</PublishProtocol>
    </PropertyGroup>

    <!-- After every publish, make sure %APPDATA%\sb-cli (where sb-cli.exe now lives) is on the user's PATH. -->
    <Target Name="AddSbInstallDirToUserPath" AfterTargets="Publish">
        <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)Add-ToUserPath.ps1&quot; -Directory &quot;$(PublishDir.TrimEnd('\'))&quot;" />
    </Target>
</Project>