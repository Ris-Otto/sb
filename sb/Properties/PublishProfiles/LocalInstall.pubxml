<Project>
  <!--
    Publishes sb as a single, self-contained sb.exe directly into the same folder the app itself
    uses for its SQLite index (%APPDATA%\sb\ — see Program.cs), and makes sure that folder is on
    the user's PATH so `sb` can be run from any shell. Run via:
      dotnet publish sb\sb.csproj -p:PublishProfile=LocalInstall
    Re-running it simply overwrites sb.exe (and its few companion files) in place with the newly
    built version — dotnet publish always replaces same-named files in PublishDir, no separate
    "clean" step is needed.
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishDir>$(APPDATA)\sb\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
  </PropertyGroup>

  <!--
    Belt-and-suspenders: MSBuild's normal CopyToPublishDirectory item-copy step has proven
    unreliable across repeated runs with a PublishDir outside the usual bin/obj tree (observed:
    template-main.tex present after one publish, silently gone after the very next one, even with
    CopyToPublishDirectory set on the item in sb.csproj). LeafletBuilder/DocumentStore can't
    function without this file (it's the master document template, resolved relative to the exe's
    own directory at runtime), so copy it here unconditionally, every publish, regardless of
    whatever the incremental item-copy step decided to do.
  -->
  <Target Name="EnsureTemplateMainTexIsPublished" AfterTargets="Publish">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\template-main.tex" DestinationFolder="$(PublishDir.TrimEnd('\'))" SkipUnchangedFiles="false" />
  </Target>

  <!-- After every publish, make sure %APPDATA%\sb (where sb.exe now lives) is on the user's PATH. -->
  <Target Name="AddSbInstallDirToUserPath" AfterTargets="Publish">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)Add-ToUserPath.ps1&quot; -Directory &quot;$(PublishDir.TrimEnd('\'))&quot;" />
  </Target>
</Project>
