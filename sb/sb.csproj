<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Keep our own Program.Main as the real entry point; the test SDK would otherwise
             generate its own and silently shadow it (CS8892). -->
        <GenerateProgramFile>false</GenerateProgramFile>
        <!-- Defense-in-depth for console output encoding (003-utf8-encoding, research.md §1) —
             does not fix command-line argument decoding, which .NET already handles correctly on
             this platform via GetCommandLineW. -->
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>



    <ItemGroup>
      <PackageReference Include="NUnit" Version="4.2.2" />
      <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
      <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
      <PackageReference Include="System.CommandLine" Version="2.0.0" />
      <PackageReference Include="YamlDotNet" Version="16.2.0" />
      <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.9" />
      <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    </ItemGroup>

    <ItemGroup>
      <None Include="Tests/TestFiles/**/*" CopyToOutputDirectory="PreserveNewest" />
      <None Include="template-main.tex" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
